          "name": "Run a bulk job",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/bulk/:job_id/run", "host": ["{{baseUrl}}"], "path": ["bulk", ":job_id", "run"], "variable": [{ "key": "job_id", "value": "" }] },
