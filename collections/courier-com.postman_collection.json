            "body": { "mode": "raw", "raw": "{\n  \"message\": { \"template\": \"TEMPLATE_ID\" }\n}" },
            "url": { "raw": "{{baseUrl}}/bulk", "host": ["{{baseUrl}}"], "path": ["bulk"] },
            "description": "Create a bulk job for a one-to-many send."
