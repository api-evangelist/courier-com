          "name": "Invoke an ad-hoc automation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"automation\": { \"steps\": [] },\n  \"recipient\": \"USER_ID\"\n}" },
            "url": { "raw": "{{baseUrl}}/automations/invoke", "host": ["{{baseUrl}}"], "path": ["automations", "invoke"] },
            "description": "Invoke an automation run defined inline."
          }
        },
        {
          "name": "Invoke an automation template",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"recipient\": \"USER_ID\"\n}" },
            "url": { "raw": "{{baseUrl}}/automations/:template_id/invoke", "host": ["{{baseUrl}}"], "path": ["automations", ":template_id", "invoke"], "variable": [{ "key": "template_id", "value": "" }] },
